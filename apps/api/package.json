{
  "name": "@fool/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');for (const p of ['dist']) try { fs.rmSync(p, { recursive: true, force: true }); } catch {}\"",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-email-templates.mjs",
    "dev": "npm run build && node --watch dist/server.js",
    "start": "node dist/server.js",
    "platform:migrate": "node dist/platform-migrate.js",
    "platform:worker": "node dist/platform-worker.js",
    "platform:projection": "node dist/platform-projection.js",
    "platform:backfill:dry-run": "node dist/platform-backfill.js",
    "platform:backfill:apply": "node dist/platform-backfill.js --apply",
    "platform:backup": "node dist/platform-backup.js",
    "platform:restore": "node dist/platform-restore.js",
    "execution:worker": "node dist/execution/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run clean && npm run build && node --test --test-concurrency=1 dist/engine/tests"
  },
  "dependencies": {
    "@fool/collectors": "0.1.0",
    "@fool/core": "0.1.0",
    "@fool/restorers": "0.1.0",
    "@types/sqlite3": "^5.1.0",
    "dompurify": "^3.2.4",
    "fastify": "^4.28.1",
    "jsdom": "^25.0.1",
    "marked": "^14.1.4",
    "nodemailer": "^6.9.16",
    "otpauth": "^9.3.6",
    "pg": "8.16.3",
    "qrcode": "^1.5.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/ssh2": "^1.15.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envforge.local/schemas/capability.schema.json",
  "title": "EnvForge Capability Package",
  "type": "object",
  "required": [
    "id",
    "name",
    "publisher",
    "status",
    "riskLevel",
    "supports",
    "features",
    "permissions",
    "requiresGates",
    "testMatrix",
    "fixtures",
    "certification",
    "redaction",
    "safety",
    "docs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["experimental", "community", "verified", "official", "production-certified"]
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "catalogRefs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supports": {
      "type": "object",
      "required": ["os", "architectures"],
      "properties": {
        "os": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "architectures": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "features": {
      "type": "object",
      "required": ["discover", "plan", "apply", "verify", "rollback"],
      "properties": {
        "discover": { "type": "boolean" },
        "plan": { "type": "boolean" },
        "apply": { "type": "boolean" },
        "verify": { "type": "boolean" },
        "rollback": {
          "type": "string",
          "enum": ["none", "partial", "full", "manual"]
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["read", "write", "commands"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } },
        "commands": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requiresGates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "config-diff-confirm",
          "service-reload-confirm",
          "data-migration-strategy-confirm",
          "secret-handling-confirm",
          "backup-freshness-confirm",
          "version-compatibility-confirm",
          "manual-follow-up-confirm"
        ]
      }
    },
    "testMatrix": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "type"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "type": { "type": "string" },
          "covers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "certification": {
      "type": "object",
      "required": ["evidence"],
      "properties": {
        "evidence": { "type": "object" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "redaction": {
      "type": "object",
      "required": ["sensitiveKeys", "assertions"],
      "properties": {
        "sensitiveKeys": { "type": "array", "items": { "type": "string" } },
        "assertions": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "approvedPlanRequired",
        "appliesViaManagedExecution",
        "publicMutationApi",
        "directMutationRoutes",
        "environmentPlanBoundary"
      ],
      "properties": {
        "approvedPlanRequired": { "type": "boolean" },
        "appliesViaManagedExecution": { "type": "boolean" },
        "publicMutationApi": { "type": "boolean" },
        "directMutationRoutes": { "type": "array", "items": { "type": "string" } },
        "environmentPlanBoundary": { "type": "string" }
      }
    },
    "docs": {
      "type": "object",
      "required": ["readme"],
      "properties": {
        "readme": { "type": "string" }
      }
    }
  }
}

